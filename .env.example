# PostgreSQL connection string for the database (Railway or local)
DATABASE_URL=
DATABASE_URL_TEST=

# Shopify Partner application Client ID / API key
SHOPIFY_API_KEY=

# Shopify Partner application Client Secret
SHOPIFY_API_SECRET=

# Comma-separated list of Shopify API access scopes required by the app
SCOPES=

# Public HTTPS URL of the application (e.g., https://app.cartlightlabs.com)
SHOPIFY_APP_URL=

# 32-byte base64-encoded string used for AES-256-GCM encryption of merchant API keys at rest
ENCRYPTION_KEY=

# Sentry project DSN for application error logging and performance tracking
SENTRY_DSN=

# Whether Shopify Billing runs in test mode without charging real credit cards (true/false, default: true)
BILLING_TEST_MODE=true
